# Variables que se configuran en Vercel (Settings → Environment Variables). Nunca subas los valores reales a GitHub.

# API key de Gemini (Google AI Studio → Get API key)
GEMINI_API_KEY=

# ID de cliente OAuth de Google para "Iniciar sesión con Google" (Google Cloud → Credenciales → ID de cliente OAuth, tipo Aplicación web)
GOOGLE_CLIENT_ID=

# Dominio de correo autorizado para entrar
ALLOWED_DOMAIN=gmacro.com

# Modelos de Gemini (opcionales; estos son los valores por defecto)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Lo crea Vercel al conectar el almacenamiento Blob al proyecto
BLOB_READ_WRITE_TOKEN=
